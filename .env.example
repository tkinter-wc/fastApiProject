# MySQL（异步 SQLAlchemy）
DATABASE_URL=mysql+aiomysql://user:password@localhost:3306/news_app?charset=utf8mb4
DB_ECHO=true
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600
DB_POOL_PRE_PING=true

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_DECODE_RESPONSES=true

# 业务缓存过期（秒）
CATEGORIES_CACHE_EXPIRE=7200
NEWS_LIST_CACHE_EXPIRE=1800
NEWS_DETAIL_CACHE_EXPIRE=300
